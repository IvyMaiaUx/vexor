# Vexor E2E (Playwright) - Template
# Copy this file to .env.e2e.local for authenticated E2E tests.
# NEVER commit .env.e2e.local or real credentials.

E2E_BASE_URL=http://localhost:3000

# Dedicated non-admin test user (optional; auth/profile tests requiring login skip if unset)
E2E_EMAIL=
E2E_PASSWORD=

# Safety gates — keep false by default to avoid sending real emails or mutating credentials
E2E_ALLOW_EMAILS=false
E2E_ALLOW_PASSWORD_CHANGE=false

# Optional isolated signup test address (only used when E2E_ALLOW_EMAILS=true)
E2E_SIGNUP_EMAIL=
E2E_SIGNUP_USERNAME=
