# Supabase Configuration (Public client keys - safe for browser WITH RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# Local Database URL (Only for running SQL migrations / smoke tests via psql)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/cybersec_platform

# Server-only URL Safety Checking APIs (NEVER expose with NEXT_PUBLIC_)
# Layer 1: URLhaus Auth-Key (free at https://auth.abuse.ch/ — skipped if empty)
# URLHAUS_AUTH_KEY=
# Layer 2: Google reputation provider ("safebrowsing" for non-commercial, or "webrisk" for commercial)
# URL_REPUTATION_PROVIDER=safebrowsing
# GOOGLE_SAFE_BROWSING_API_KEY=
# GOOGLE_WEB_RISK_API_KEY=
# Layer 3: VirusTotal public API (single key only — 4 req/min, 500 req/day, queued with Retry-After)
# VIRUSTOTAL_API_KEY=
